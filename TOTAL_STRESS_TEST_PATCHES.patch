+                  return Center(
+                    child: Padding(
+                      padding: const EdgeInsets.all(24),
+                      child: Text(
+                        _search.text.isEmpty && _tag == null
+                            ? 'Здесь будут Ваши заметки. Нажмите «Новая заметка», чтобы начать.'
+                            : 'Подходящих заметок нет. Измените поиск или метку.',
+                      ),
+                    ),
+                  );
+                }
+                return RefreshIndicator(
+                  onRefresh: () async {
+                    setState(_reload);
+                    await _notes;
+                  },
+                  child: ListView.builder(
+                    padding: const EdgeInsets.fromLTRB(12, 8, 12, 96),
+                    itemCount: notes.length,
+                    itemBuilder: (context, index) {
+                      final note = notes[index];
+                      return Card(
+                        child: ListTile(
+                          title: Text(
+                            note.title.isEmpty ? 'Без названия' : note.title,
+                            maxLines: 2,
+                            overflow: TextOverflow.ellipsis,
+                          ),
+                          subtitle: Text(
+                            note.readOnlyHtml
+                                ? 'Форматированная заметка с компьютера'
+                                : note.body,
+                            maxLines: 2,
+                            overflow: TextOverflow.ellipsis,
+                          ),
+                          onTap: () => _open(note),
+                        ),
+                      );
+                    },
+                  ),
+                );
+              },
+            ),
+          ),
+        ],
+      ),
+    ),
+    floatingActionButton: FloatingActionButton.extended(
+      onPressed: () => _open(),
+      icon: const Icon(Icons.add),
+      label: const Text('Новая заметка'),
+    ),
+  );
+}
