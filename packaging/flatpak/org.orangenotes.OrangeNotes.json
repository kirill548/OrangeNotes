{
  "app-id": "org.orangenotes.OrangeNotes",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "OrangeNotes",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "orangenotes",
      "buildsystem": "simple",
      "build-commands": [
        "install -d /app/lib/orangenotes /app/bin /app/share/applications /app/share/icons/hicolor/256x256/apps",
        "cp -a bundle/. /app/lib/orangenotes/",
        "install -m755 /usr/bin/gdbus /app/bin/gdbus",
        "install -m755 OrangeNotes /app/bin/OrangeNotes",
        "install -m644 org.orangenotes.desktop.desktop /app/share/applications/org.orangenotes.OrangeNotes.desktop",
        "install -m644 bundle/OrangeNotes.png /app/share/icons/hicolor/256x256/apps/org.orangenotes.OrangeNotes.png"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../../dist/OrangeNotes",
          "dest": "bundle"
        },
        {
          "type": "file",
          "path": "OrangeNotes"
        },
        {
          "type": "file",
          "path": "org.orangenotes.desktop.desktop"
        }
      ]
    }
  ]
}
